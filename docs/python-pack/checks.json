{
  "afterEdit": [
    { "extensions": [".py"], "run": ["uv", "run", "--no-build", "ruff", "format", "{file}"], "fix": true },
    { "extensions": [".py"], "run": ["uv", "run", "--no-build", "ruff", "check", "{file}"] }
  ],
  "beforeStop": [
    { "run": ["uv", "run", "--no-build", "ruff", "format", "--check", "."] },
    { "run": ["uv", "run", "--no-build", "ruff", "check", "."] },
    { "run": ["uv", "run", "--no-build", "mypy"] },
    { "run": ["node", "scripts/check-rules.js", "scripts/rules.json"] },
    { "run": ["uv", "run", "--no-build", "python", "scripts/check_imports.py"] },
    { "run": ["uv", "run", "--no-build", "pytest", "-q"] }
  ]
}
